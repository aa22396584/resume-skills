#!/usr/bin/env python3
"""Run portable-resume directly from a source checkout or release archive."""

from __future__ import annotations

import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
SRC = os.path.join(ROOT, "src")
try:
    sys.path.remove(SRC)
except ValueError:
    pass
sys.path.insert(0, SRC)

from portable_resume.reader import main

raise SystemExit(main())
